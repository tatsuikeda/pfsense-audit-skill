<?xml version="1.0"?>
<!--
  Synthetic pfSense CE 2.9 style config.xml for offline tests. Not taken from
  any real firewall: documentation addresses (RFC 5737), example.com names,
  and placeholder hashes only. Only the paths pfaudit.py reads are present.
  "Good" variant: every check should PASS, or report INFO where INFO is the
  best possible result.
-->
<pfsense>
	<version>24.6</version>
	<system>
		<hostname>fw</hostname>
		<domain>example.com</domain>
		<webgui>
			<protocol>https</protocol>
			<session_timeout>15</session_timeout>
			<ssl-certref>certgui01</ssl-certref>
		</webgui>
		<ssh>
			<enable>enabled</enable>
			<sshdkeyonly>enabled</sshdkeyonly>
		</ssh>
		<sshguard_threshold>20</sshguard_threshold>
		<user>
			<name>admin</name>
			<uid>0</uid>
			<bcrypt-hash>FIXTURE-NOT-A-REAL-HASH-0</bcrypt-hash>
		</user>
		<user>
			<name>alice</name>
			<uid>2000</uid>
			<bcrypt-hash>FIXTURE-NOT-A-REAL-HASH-1</bcrypt-hash>
		</user>
		<user>
			<name>former</name>
			<uid>2001</uid>
			<disabled></disabled>
		</user>
		<group>
			<name>admins</name>
			<member>0</member>
			<member>2000</member>
		</group>
		<dns1host>dns.example.com</dns1host>
		<acb>
			<enable>yes</enable>
		</acb>
		<crypto_hardware>aesni</crypto_hardware>
		<thermal_hardware>coretemp</thermal_hardware>
	</system>
	<interfaces>
		<wan>
			<if>igb0</if>
			<ipaddr>203.0.113.2</ipaddr>
			<blockpriv></blockpriv>
			<blockbogons></blockbogons>
			<gateway>WANGW</gateway>
		</wan>
		<lan>
			<if>igb1</if>
			<ipaddr>192.0.2.1</ipaddr>
		</lan>
		<opt1>
			<if>igb1.20</if>
			<ipaddr>198.51.100.1</ipaddr>
			<descr>GUEST</descr>
		</opt1>
	</interfaces>
	<vlans>
		<vlan>
			<if>igb1</if>
			<tag>20</tag>
			<vlanif>igb1.20</vlanif>
		</vlan>
	</vlans>
	<virtualip>
		<vip>
			<mode>ipalias</mode>
			<interface>lo0</interface>
			<uniqid>5f00aa01</uniqid>
			<subnet>198.51.100.250</subnet>
			<descr>pfB DNSBL</descr>
		</vip>
	</virtualip>
	<filter>
		<rule>
			<type>block</type>
			<interface>lan</interface>
			<protocol>tcp/udp</protocol>
			<source><network>lan</network></source>
			<destination><any></any><port>853</port></destination>
			<descr>Block DNS over TLS</descr>
		</rule>
		<rule>
			<type>block</type>
			<interface>lan</interface>
			<protocol>tcp/udp</protocol>
			<source><network>lan</network></source>
			<destination><any></any><port>53</port></destination>
			<descr>Block outbound DNS</descr>
		</rule>
		<rule>
			<type>pass</type>
			<interface>openvpn</interface>
			<protocol>tcp</protocol>
			<source><any></any></source>
			<destination><address>192.0.2.20</address><port>443</port></destination>
			<descr>VPN to file server</descr>
		</rule>
		<rule>
			<type>pass</type>
			<interface>openvpn</interface>
			<source><any></any></source>
			<destination><any></any></destination>
			<disabled></disabled>
			<descr>Old allow all, disabled</descr>
		</rule>
	</filter>
	<nat></nat>
	<openvpn>
		<openvpn-server>
			<vpnid>1</vpnid>
			<description>RemoteAccess</description>
			<mode>server_tls_user</mode>
			<protocol>UDP4</protocol>
			<authmode>RADIUS MFA</authmode>
			<tls_type>crypt</tls_type>
			<digest>SHA256</digest>
			<data_ciphers>AES-256-GCM,CHACHA20-POLY1305</data_ciphers>
			<data_ciphers_fallback>AES-256-GCM</data_ciphers_fallback>
			<dh_length>4096</dh_length>
			<crlref>crl00001</crlref>
			<strictusercn>yes</strictusercn>
			<certref>certvpn01</certref>
			<allow_compression>no</allow_compression>
			<topology>subnet</topology>
			<tunnel_network>198.51.100.128/25</tunnel_network>
		</openvpn-server>
	</openvpn>
	<crl>
		<refid>crl00001</refid>
		<descr>RemoteAccess CRL</descr>
	</crl>
	<cert>
		<refid>certgui01</refid>
		<descr>GUI certificate</descr>
		<autorenew>enabled</autorenew>
	</cert>
	<cert>
		<refid>certvpn01</refid>
		<descr>VPN server certificate</descr>
		<autorenew>enabled</autorenew>
	</cert>
	<unbound>
		<enable></enable>
		<forwarding></forwarding>
		<forward_tls_upstream></forward_tls_upstream>
		<dnssec></dnssec>
		<custom_options>c2VydmVyOgpsb2ctcXVlcmllczogbm8K</custom_options>
	</unbound>
	<gateways>
		<gateway_item>
			<name>WANGW</name>
			<interface>wan</interface>
			<gateway>203.0.113.1</gateway>
			<monitor>198.51.100.53</monitor>
		</gateway_item>
		<gateway_item>
			<name>LTEGW</name>
			<interface>opt2</interface>
			<gateway>dynamic</gateway>
		</gateway_item>
	</gateways>
	<notifications>
		<smtp>
			<ipaddress>mail.example.com</ipaddress>
			<notifyemailaddress>alerts@example.com</notifyemailaddress>
		</smtp>
		<certexpire>
			<enable>enabled</enable>
		</certexpire>
	</notifications>
	<syslog>
		<remoteserver>198.51.100.10:514</remoteserver>
	</syslog>
	<installedpackages>
		<pfblockerngdnsblsettings>
			<config>
				<pfb_dnsbl>on</pfb_dnsbl>
				<dnsbl_mode>dnsbl_python</dnsbl_mode>
				<pfb_dnsvip4>_vip5f00aa01</pfb_dnsvip4>
				<pfb_tld>on</pfb_tld>
				<pfb_cname>on</pfb_cname>
				<pfb_control>on</pfb_control>
			</config>
		</pfblockerngdnsblsettings>
		<pfblockerngipsettings>
			<config>
				<killstates>on</killstates>
			</config>
		</pfblockerngipsettings>
		<pfblockerngdnsbl>
			<config>
				<row>
					<state>Enabled</state>
					<url>https://user:fixture-token@192.0.2.7/ads.txt?key=fixture-key#frag</url>
				</row>
				<row>
					<state>Disabled</state>
					<url>https://lists.example.com/disabled.txt</url>
				</row>
			</config>
		</pfblockerngdnsbl>
		<pfblockernglistsv4>
			<config>
				<row>
					<url>http://127.0.0.1/local-list.txt</url>
				</row>
			</config>
		</pfblockernglistsv4>
		<patches>
			<autoapply_recommended></autoapply_recommended>
		</patches>
		<nut>
			<config>
				<email>yes</email>
			</config>
		</nut>
	</installedpackages>
</pfsense>
